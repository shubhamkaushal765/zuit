{
  "_comment": "zuit-sync: generated by `cargo xtask sync` from meta/project.toml. Do not edit.",
  "name": "zuit",
  "version": "0.1.0",
  "description": "Multi-language static analysis CLI emitting structured findings on multiple quality dimensions.",
  "license": "MIT",
  "author": "Shubham Kaushal",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhamkaushal765/zuit"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "zuit": "bin/zuit.js"
  },
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "name": "zuit",
    "triples": {
      "defaults": true,
      "additional": ["aarch64-apple-darwin", "aarch64-unknown-linux-gnu"]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "artifacts": "napi artifacts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
